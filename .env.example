# GitHub token for the homepage GitHub section (server-side only, never prefix with NEXT_PUBLIC_).
# Read-only access to public data is enough. Without it the section shows pinned repos only.
GITHUB_TOKEN=

# Absolute site URL, e.g. https://example.com (no trailing slash). Used for canonical URLs
# and for the links in the client auto-reply email. Falls back to Vercel's production domain.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (/api/contact) ---
# Resend API key (server-side only). Without it no email is sent and the form returns an error.
RESEND_API_KEY=
# Verified Resend sender used for both emails, e.g. "Your Name <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Inbox that receives new inquiries. Defaults to the email in lib/site.ts when empty.
CONTACT_TO_EMAIL=
# "true" also sends the client a confirmation email after your inquiry email succeeds. Any other value disables it.
CONTACT_SEND_AUTOREPLY=
